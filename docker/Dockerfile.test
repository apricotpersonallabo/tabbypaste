FROM node:22.23.2-bookworm-slim

ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    CI=true \
    HOME=/tmp/test-home \
    PNPM_HOME=/tmp/pnpm-home \
    PATH=/tmp/pnpm-home:$PATH

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl jq openssl unzip zip \
    && rm -rf /var/lib/apt/lists/* \
    && corepack enable \
    && corepack prepare pnpm@11.19.0 --activate \
    && mkdir -p /tmp/test-home /tmp/pnpm-home \
    && chmod 1777 /tmp/test-home /tmp/pnpm-home

WORKDIR /workspace

CMD ["sh", "-lc", "pnpm install --frozen-lockfile --ignore-scripts && pnpm run test:all:container"]
